    PRINT "ARM CortexM3 access to eSRAM module 1 read is protected.";
    UL_BUS_IDS_ESRAM1_R_SELECT:
    IF ( ! (SEC_UL[34]==1) ) THEN GOTO UL_BUS_IDS_ESRAM1_W_SELECT;
    PRINT "ARM CortexM3 access to eSRAM module 1 write is protected.";
    UL_BUS_IDS_ESRAM1_W_SELECT:
    IF ( ! (SEC_UL[35]==1) ) THEN GOTO UL_BUS_IDS_ENVM0_R_SELECT;
    PRINT "ARM CortexM3 access to eNVM_0 read is protected.";
    UL_BUS_IDS_ENVM0_R_SELECT:
    IF ( ! (SEC_UL[36]==1) ) THEN GOTO UL_BUS_IDS_ENVM0_W_SELECT;
    PRINT "ARM CortexM3 access to eNVM_0 write is protected.";
    UL_BUS_IDS_ENVM0_W_SELECT:
    IF ( ! (SEC_UL[39]==1) ) THEN GOTO UL_BUS_IDS_DDR_R_SELECT;
    PRINT "ARM CortexM3 access to DDR bridge read is protected.";
    UL_BUS_IDS_DDR_R_SELECT:
    IF ( ! (SEC_UL[40]==1) ) THEN GOTO UL_BUS_IDS_DDR_W_SELECT;
