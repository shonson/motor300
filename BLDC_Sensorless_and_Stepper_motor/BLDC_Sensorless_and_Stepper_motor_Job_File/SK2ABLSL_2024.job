DATA SHA256;
    BOOLEAN SHA256_UPDATE_DATA[32767];
    INTEGER SHA256_UPDATE_DATA_SIZE =0;
    BOOLEAN SHA256_HASH[256];
    INTEGER SHA256_CTX_DATA[64];
    INTEGER SHA256_CTX_DATALEN;
    INTEGER SHA256_CTX_BITLEN;
    INTEGER SHA256_CTX_STATE[8];
    INTEGER SHA256_SIG0_X;
    INTEGER SHA256_SIG0_RES;
    INTEGER SHA256_SIG1_X;
    INTEGER SHA256_SIG1_RES;
    INTEGER SHA256_EP0_X;
    INTEGER SHA256_EP0_RES;
    INTEGER SHA256_EP1_X;
    INTEGER SHA256_EP1_RES;
    INTEGER SHA256_CH_X;
    INTEGER SHA256_CH_Y;
    INTEGER SHA256_CH_Z;
    INTEGER SHA256_CH_RES;
    INTEGER SHA256_MAJ_X;
    INTEGER SHA256_MAJ_Y;
    INTEGER SHA256_MAJ_Z;
    INTEGER SHA256_MAJ_RES;
    INTEGER SHA256_ROTRIGHT_A;
    INTEGER SHA256_ROTRIGHT_B;
    INTEGER SHA256_ROTRIGHT_RES;
    INTEGER SHA256_RSHIFT_X;
    INTEGER SHA256_RSHIFT_Y;
    INTEGER SHA256_RSHIFT_RES;
    INTEGER SHA256_UADD_X;
    INTEGER SHA256_UADD_Y;
    INTEGER SHA256_UADD_RES;
    INTEGER SHA256_K[64] = 1116352408,1899447441,-1245643825,-373957723,961987163
        ,1508970993,-1841331548,-1424204075,-670586216,310598401,607225278,1426881987
        ,1925078388,-2132889090,-1680079193,-1046744716,-459576895,-272742522,264347078
        ,604807628,770255983,1249150122,1555081692,1996064986,-1740746414,-1473132947
        ,-1341970488,-1084653625,-958395405,-710438585,113926993,338241895,666307205
        ,773529912,1294757372,1396182291,1695183700,1986661051,-2117940946,-1838011259
        ,
    -1564481375,-1474664885,-1035236496,-949202525,-778901479,-694614492,-200395387
        ,275423344,430227734,506948616,659060556,883997877,958139571,1322822218,1537002063
