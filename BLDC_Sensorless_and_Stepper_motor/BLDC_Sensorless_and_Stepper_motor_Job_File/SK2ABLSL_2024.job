    UL_BUS_IDS_DDR_W_SELECT:
    IF ( ! (SEC_UL[41]==1) ) THEN GOTO UL_BUS_FIC_ESRAM0_R_SELECT;
    PRINT "Fabric access to eSRAM module 0 read is protected.";
