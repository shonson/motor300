        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO AUXLO_PASS;
    PRINT "Instruction timed out while loading auxlo.";
    EXPORT "auxlo_result", AUXLO_RESULT[127..0];
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    AUXLO_PASS:
    LABEL_SEPARATOR = 0;
ENDPROC;

