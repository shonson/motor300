    UL_BUS_FIC_ENVM0_W_SELECT:
    IF ( ! (SEC_UL[49]==1) ) THEN GOTO UL_BUS_FIC_DDR_R_SELECT;
    PRINT "Fabric access to DDR bridge read is protected.";
    UL_BUS_FIC_DDR_R_SELECT:
    IF ( ! (SEC_UL[50]==1) ) THEN GOTO UL_BUS_FIC_DDR_W_SELECT;
    PRINT "Fabric access to DDR bridge write is protected.";
    UL_BUS_FIC_DDR_W_SELECT:
    IF ( ! (SEC_UL[51]==1) ) THEN GOTO UL_BUS_EXT_ESRAM0_R_SELECT;
    PRINT "External master access to eSRAM module 0 read is protected.";
    UL_BUS_EXT_ESRAM0_R_SELECT:
    IF ( ! (SEC_UL[52]==1) ) THEN GOTO UL_BUS_EXT_ESRAM0_W_SELECT;
    PRINT "External master access to eSRAM module 0 write is protected.";
    UL_BUS_EXT_ESRAM0_W_SELECT:
    IF ( ! (SEC_UL[53]==1) ) THEN GOTO UL_BUS_EXT_ESRAM1_R_SELECT;
    PRINT "External master access to eSRAM module 1 read is protected.";
    UL_BUS_EXT_ESRAM1_R_SELECT:
    IF ( ! (SEC_UL[54]==1) ) THEN GOTO UL_BUS_EXT_ESRAM1_W_SELECT;
    PRINT "External master access to eSRAM module 1 write is protected.";
    UL_BUS_EXT_ESRAM1_W_SELECT:
    IF ( ! (SEC_UL[55]==1) ) THEN GOTO UL_BUS_EXT_ENVM0_R_SELECT;
    PRINT "External master access to eNVM_0 read is protected.";
    UL_BUS_EXT_ENVM0_R_SELECT:
    IF ( ! (SEC_UL[56]==1) ) THEN GOTO UL_BUS_EXT_ENVM0_W_SELECT;
    PRINT "External master access to eNVM_0 write is protected.";
    UL_BUS_EXT_ENVM0_W_SELECT:
    IF ( ! (SEC_UL[59]==1) ) THEN GOTO UL_BUS_EXT_DDR_R_SELECT;
    PRINT "External master access to DDR bridge read is protected.";
    UL_BUS_EXT_DDR_R_SELECT:
    IF ( ! (SEC_UL[60]==1) ) THEN GOTO UL_BUS_EXT_DDR_W_SELECT;
    PRINT "External master access to DDR bridge write is protected.";
    UL_BUS_EXT_DDR_W_SELECT:
    IF ( ! (SEC_UL[71]==1) ) THEN GOTO UL_M3_ALLOWED_L0_SELECT;
    PRINT "ARM CortexM3 access to address range: 0x0000-0x0fff of eNVM_0 is protected.";
    UL_M3_ALLOWED_L0_SELECT:
    IF ( ! (SEC_UL[72]==1) ) THEN GOTO UL_FAB_ALLOWED_L0_SELECT;
    PRINT "Fabric access to address range: 0x0000-0x0fff of eNVM_0 is protected.";
    UL_FAB_ALLOWED_L0_SELECT:
    IF ( ! (SEC_UL[73]==1) ) THEN GOTO UL_OTHERS_ALLOWED_L0_SELECT;
    PRINT "Other masters access to address range: 0x0000-0x0fff of eNVM_0 is protected.";
    UL_OTHERS_ALLOWED_L0_SELECT:
    IF ( ! (SEC_UL[74]==1) ) THEN GOTO UL_WRITE_ALLOWED_L0_SELECT;
    PRINT "Master write access to address range: 0x0000-0x0fff of eNVM_0 is protected.";
    UL_WRITE_ALLOWED_L0_SELECT:
    IF ( ! (SEC_UL[75]==1) ) THEN GOTO UL_M3_ALLOWED_U0_SELECT;
    PRINT "ARM CortexM3 access to address range: 0x3f000-0x3ffff of eNVM_0 is protected.";
    UL_M3_ALLOWED_U0_SELECT:
    IF ( ! (SEC_UL[76]==1) ) THEN GOTO UL_FAB_ALLOWED_U0_SELECT;
    PRINT "Fabric access to address range: 0x3f000-0x3ffff of eNVM_0 is protected.";
    UL_FAB_ALLOWED_U0_SELECT:
    IF ( ! (SEC_UL[77]==1) ) THEN GOTO UL_OTHERS_ALLOWED_U0_SELECT;
    PRINT "Other masters access to address range: 0x3f000-0x3ffff of eNVM_0 is protected.";
    UL_OTHERS_ALLOWED_U0_SELECT:
    IF ( ! (SEC_UL[78]==1) ) THEN GOTO UL_WRITE_ALLOWED_U0_SELECT;
    PRINT "Master write access to address range: 0x3f000-0x3ffff of eNVM_0 is protected.";
    UL_WRITE_ALLOWED_U0_SELECT:
    IF ( ! (SEC_UL[79]==1) ) THEN GOTO UL_M3_ALLOWED_L1_SELECT;
    PRINT "ARM CortexM3 access to address range: 0x3e000-0x3efff of eNVM_0 is protected.";
    UL_M3_ALLOWED_L1_SELECT:
    IF ( ! (SEC_UL[80]==1) ) THEN GOTO UL_FAB_ALLOWED_L1_SELECT;
    PRINT "Fabric access to address range: 0x3e000-0x3efff of eNVM_0 is protected.";
    UL_FAB_ALLOWED_L1_SELECT:
    IF ( ! (SEC_UL[81]==1) ) THEN GOTO UL_OTHERS_ALLOWED_L1_SELECT;
    PRINT "Other masters access to address range: 0x3e000-0x3efff of eNVM_0 is protected.";
    UL_OTHERS_ALLOWED_L1_SELECT:
    IF ( ! (SEC_UL[82]==1) ) THEN GOTO UL_WRITE_ALLOWED_L1_SELECT;
    PRINT "Master write access to address range: 0x3e000-0x3efff of eNVM_0 is protected.";
    UL_WRITE_ALLOWED_L1_SELECT:
    IF ( ! (SEC_UL[83]==1) ) THEN GOTO UL_M3_ALLOWED_U1_SELECT;
    PRINT "ARM CortexM3 access to address range: 0x3d000-0x3dfff of eNVM_0 is protected.";
    UL_M3_ALLOWED_U1_SELECT:
    IF ( ! (SEC_UL[84]==1) ) THEN GOTO UL_FAB_ALLOWED_U1_SELECT;
    PRINT "Fabric access to address range: 0x3d000-0x3dfff of eNVM_0 is protected.";
    UL_FAB_ALLOWED_U1_SELECT:
    IF ( ! (SEC_UL[85]==1) ) THEN GOTO UL_OTHERS_ALLOWED_U1_SELECT;
    PRINT "Other masters access to address range: 0x3d000-0x3dfff of eNVM_0 is protected.";
    UL_OTHERS_ALLOWED_U1_SELECT:
    IF ( ! (SEC_UL[86]==1) ) THEN GOTO UL_WRITE_ALLOWED_U1_SELECT;
    PRINT "Master write access to address range: 0x3d000-0x3dfff of eNVM_0 is protected.";
    UL_WRITE_ALLOWED_U1_SELECT:
    IF ( ! (SEC_UL[30]==1) ) THEN GOTO UL_AUTO_DIGEST_POR_SELECT;
    PRINT "Automatic digest check at power up is enabled.";
    IF ( ! ( (SEC_UCNFG[4]==1)&&(SEC_UL[10]==0)) ) THEN GOTO AUTODIGEST_FABRIC_SELECT;
    PRINT "FPGA array power on digest is enabled.";
    AUTODIGEST_FABRIC_SELECT:
    IF ( ! (SEC_UCNFG[5]==1) ) THEN GOTO AUTODIGEST_ENVM0_SELECT;
    PRINT "eNVM_0 power on digest is enabled.";
    AUTODIGEST_ENVM0_SELECT:
    LABEL_SEPARATOR = 0;
    UL_AUTO_DIGEST_POR_SELECT:
    IF ( ! ( (SEC_UCNFG[15]==0)&&(SEC_UCNFG[12]==0)) ) THEN GOTO IAPUPDATE_ENABLE_SELECT;
    PRINT "Programming recovery and auto-update are enabled.";
    IAPUPDATE_ENABLE_SELECT:
    IF ( ! ( (SEC_UCNFG[12]==0)&&(SEC_UCNFG[15]==1)) ) THEN GOTO IAPRECOVERY_ENABLE_SELECT;
    PRINT "Programming recovery is enabled.";
    IAPRECOVERY_ENABLE_SELECT:
    IF ( ! (SEC_UKL[0]==1) ) THEN GOTO UKSL_SELECT;
    PRINT "User Key Set 1 is erase/write protected.";
    UKSL_SELECT:
    IF ( ! (SEC_UKL[1]==1) ) THEN GOTO UKSVL_SELECT;
    PRINT "User Key Set 1 is verify protected.";
    UKSVL_SELECT:
    IF ( ! (SEC_VL[0]==1) ) THEN GOTO VSL_SELECT;
    PRINT "User Key Set 2 is erase/write protected.";
    VSL_SELECT:
    IF ( ! (SEC_VL[2]==1) ) THEN GOTO VSVL_SELECT;
    PRINT "User Key Set 2 is verify protected.";
    VSVL_SELECT:
    IF ( ! (SEC_VL[1]==1) ) THEN GOTO VSPL_SELECT;
    PRINT "User Key Set 2 is permanently locked.";
    VSPL_SELECT:
    IF ( ! ( (SEC_UL[7]==0)&&(SEC_VL[3]==0)) ) THEN GOTO ALLOW_FACTORY_TESTMODE_SELECT;
    PRINT "Factory test mode access is allowed.";
    ALLOW_FACTORY_TESTMODE_SELECT:
    IF ( ! ( (SEC_UL[7]==1)&&(SEC_VL[3]==0)) ) THEN GOTO PROTECT_FACTORY_TESTMODE_SELECT;
    PRINT "Factory test mode access is protected.";
    PROTECT_FACTORY_TESTMODE_SELECT:
    IF ( ! ( (SEC_UL[7]==1)&&(SEC_VL[3]==1)) ) THEN GOTO PERM_FACTORY_TESTMODE_SELECT;
    PRINT "Factory test mode access is permanently protected.";
    PERM_FACTORY_TESTMODE_SELECT:
    IF ( ! (INT(SEC_CCNFG[1..0])==0) ) THEN GOTO NOT_50US;
    PRINT "Power on reset delay: 50us";
    NOT_50US:
    IF ( ! (INT(SEC_CCNFG[1..0])==1) ) THEN GOTO NOT_1MS;
    PRINT "Power on reset delay: 1ms";
    NOT_1MS:
    IF ( ! (INT(SEC_CCNFG[1..0])==2) ) THEN GOTO NOT_10MS;
    PRINT "Power on reset delay: 10ms";
    NOT_10MS:
    IF ( ! (INT(SEC_CCNFG[1..0])==3) ) THEN GOTO NOT_100MS;
    PRINT "Power on reset delay: 100ms";
    NOT_100MS:
    IF ( ! (SEC_CCNFG[2]==1) ) THEN GOTO BG_AVM_DISABLE_SELECT;
    PRINT "System Controller Suspend Mode is disabled.";
    BG_AVM_DISABLE_SELECT:
    IF ( ! (SEC_CCNFG[2]==0) ) THEN GOTO BG_AVM_DISABLE_SELECT_ENABLED;
    PRINT "System Controller Suspend Mode is enabled.";
    BG_AVM_DISABLE_SELECT_ENABLED:
    IF ( ! (SEC_CCNFG[3]==0) ) THEN GOTO MODE1V_SELECT;
    PRINT "Operational Voltage: 1.2V";
    PRINT "Internal Oscillator: 50MHZ";
    MODE1V_SELECT:
    IF ( ! (SEC_CCNFG[3]==1) ) THEN GOTO MODE12V_SELECT;
    PRINT "Operational Voltage: 1.0V";
    PRINT "Internal Oscillator: 25MHZ";
    MODE12V_SELECT:
    IF ( ! (SEC_CL[0]==1) ) THEN GOTO OTPL_SELECT;
    PRINT "FPGA Array is one time programmable.";
    OTPL_SELECT:
    IF ( ! (SEC_DL[0]==1) ) THEN GOTO UDL_M3_DEBUG_SELECT;
    PRINT "ARM CortexM3 debug through TAP is protected.";
    UDL_M3_DEBUG_SELECT:
    IF ( ! (SEC_DL[1]==1) ) THEN GOTO UDPWL_SELECT;
    PRINT "SmartDebug write access to Active Probe and AHB memory space is protected.";
    UDPWL_SELECT:
    IF ( ! (SEC_DL[2]==1) ) THEN GOTO UDPRL_SELECT;
    PRINT "SmartDebug read access to Active Probe, Live Probe, and AHB memory space is protected.";
    UDPRL_SELECT:
    IF ( ! (SEC_DL[3]==1) ) THEN GOTO ULUJ_SELECT;
    PRINT "UJTAG access to Fabric is protected.";
    ULUJ_SELECT:
    LABEL_SEPARATOR = 0;
    DO_NOT_QUERY_SEC:
    IF ( ! (SECURITY_QUERIED==0) ) THEN GOTO DUMP_SEC_CANNOTREAD;
    PRINT "Security locks and configuration settings cannot be read from the device.";
    PRINT "This could be because of debug locks, please use programming file with DPK.";
    DUMP_SEC_CANNOTREAD:
    PRINT "-------------------------------------------------";
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SET_PGM_MODE USES GV,DO_EXIT;
    BOOLEAN MODE_RESULT[8];
    BOOLEAN MODE_VALUE[8] = $00;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $af;
    DRSCAN 8, MODE_VALUE[7..0];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE MODE_RESULT[7..0];
        IF ( ! (MODE_RESULT[7]==0) ) THEN GOTO MODE_POLL;
        IPOLL = 0;
        PASS = 1;
        MODE_POLL:
        IF ( ! (PASS==0) ) THEN GOTO MODE_DONE;
        IRSCAN 8, $af;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        MODE_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO MODE_PASSED;
    PRINT "Instruction timed out while configuring device programming at 1.2 VCC voltage. ";
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    STATUS = -32;
    CALL DO_EXIT;
    MODE_PASSED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE POLL_DEVICE_READY USES GV,DO_EXIT;
    PASS = 0;
    INTEGER ILOOP_0;
    FOR ILOOP_0 = 1000000 -1 TO 0 STEP -1;
        IRSTOP IRPAUSE;
        DRSTOP DRPAUSE;
        IRSCAN 8, $8f;
        WAIT IDLE, 1 CYCLES;
        WAIT IDLE, 10 USEC;
        DRSCAN 8, $00,COMPARE $00,$80,PASS;
        IF PASS THEN ILOOP_0 = 0;
    NEXT ILOOP_0;
    IF ( ! (PASS==0) ) THEN GOTO DEVICE_READY;
    PRINT "Instruction timed out. Device is busy.";
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    STATUS = -32;
    CALL DO_EXIT;
    DEVICE_READY:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE READ_SHARED_BUFFER USES GV,DO_EXIT;
    INTEGER IBLOCK =0;
    BOOLEAN BLOCKBUFFER[129];
    FOR IBLOCK = 0 TO (IBLOCKS-1) STEP 1;
        PASS = 0;
        BOOLEAN SHARED_BUFFER_RESULT[129];
        BLOCKBUFFER[6..1] = BOOL(IBLOCK);
        IRSTOP IRPAUSE;
        DRSTOP DRPAUSE;
        IRSCAN 8, $f2;
        DRSCAN 129, BLOCKBUFFER[];
        WAIT IDLE, 3 CYCLES;
        WAIT 10 USEC, DRPAUSE;
        FOR IPOLL = 27777 TO 0 STEP -1;
            DRSCAN 129, $000000000000000000000000000000000, CAPTURE SHARED_BUFFER_RESULT[];
            IF ( ! (SHARED_BUFFER_RESULT[128]==0) ) THEN GOTO READ_BUFFER_POLL;
            IPOLL = 0;
            PASS = 1;
            READ_BUFFER_POLL:
            IF ( ! (PASS==0) ) THEN GOTO READ_BUFFER_DONE;
            IRSCAN 8, $f2;
            WAIT IRPAUSE, 10 USEC, IRPAUSE;
            READ_BUFFER_DONE:
            LABEL_SEPARATOR = 0;
        NEXT IPOLL;
        IF ( ! (PASS==0) ) THEN GOTO READ_BUFFER_PASS;
        PRINT "Instruction timed out while reading design information.";
        STATUS = -32;
        UNIQUEEXITCODE = 32818;
        BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
        EXPORT "ERROR_CODE", BUFF32[15..0];
        CALL DO_EXIT;
        READ_BUFFER_PASS:
        SHARED_BUFFER[((128*IBLOCK)+127)..(128*IBLOCK)] = SHARED_BUFFER_RESULT[127..0];
    NEXT IBLOCK;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_QUERY_SECURITY USES GV,DO_EXIT,READ_SHARED_BUFFER;
    BOOLEAN QUERY_SECURITY_RESULT[16];
    PASS = 0;
    SECURITY_QUERIED = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $b8;
    DRSCAN 16, $0000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 16, $0000, CAPTURE QUERY_SECURITY_RESULT[];
        IF ( ! (QUERY_SECURITY_RESULT[15]==0) ) THEN GOTO QUERY_SECURITY_POLL;
        IPOLL = 0;
        PASS = 1;
        QUERY_SECURITY_POLL:
        IF ( ! (PASS==0) ) THEN GOTO QUERY_SECURITY_DONE;
        IRSCAN 8, $b8;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        QUERY_SECURITY_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO QUERY_SECURITY_PASS;
    PRINT "Instruction timed out while querying security information.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    QUERY_SECURITY_PASS:
    IBLOCKS = 3;
    CALL READ_SHARED_BUFFER;
    FOR I = 0 TO 319 STEP 1;
        IF ( ! (SHARED_BUFFER[I]==1) ) THEN GOTO DO_QUERY_SECURITY_SUCCESS;
        SECURITY_QUERIED = 1;
        I = 320;
        DO_QUERY_SECURITY_SUCCESS:
        LABEL_SEPARATOR = 0;
    NEXT I;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_SECURITY USES GV,DO_QUERY_SECURITY;
    INTEGER BYTEIDX =0;
    CALL DO_QUERY_SECURITY;
    IF ( ! (SECURITY_QUERIED==0) ) THEN GOTO NOT_SEC_QUERY;
    PRINT "WARNING! Security cannot be read. This can be because of programmed debug lock. Please generate programming file with debug passkey provided.";
    NOT_SEC_QUERY:
    BYTEIDX = 0;
    SEC_UKL[5..0] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 1;
    SEC_UKL[11..6] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 2;
    SEC_VL[5..0] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 3;
    SEC_VL[11..6] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 4;
    SEC_UL[5..0] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 5;
    SEC_UL[11..6] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 6;
    SEC_UL[17..12] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 7;
    SEC_UL[23..18] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 8;
    SEC_CL[2..0] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_OPOK[2..0] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 9;
    SEC_CL[5..3] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_CCNFG[1..0] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+3)];
    SEC_OPOK[3] = SHARED_BUFFER[((BYTEIDX*8)+2)];
    BYTEIDX = 10;
    SEC_CL[8..6] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_CCNFG[4..2] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 11;
    SEC_CL[11..9] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_CCNFG[7..5] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 12;
    SEC_UL[26..24] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[2..0] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 13;
    SEC_UL[29..27] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[5..3] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 14;
    SEC_UL[32..30] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[8..6] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 15;
    SEC_UL[35..33] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[11..9] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 16;
    SEC_UL[38..36] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[14..12] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 17;
    SEC_UL[41..39] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[17..15] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 18;
    SEC_UL[44..42] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[20..18] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 19;
    SEC_UL[47..45] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[23..21] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 20;
    SEC_UL[50..48] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[26..24] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 21;
    SEC_UL[53..51] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[29..27] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 22;
    SEC_UL[56..54] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[0] = SHARED_BUFFER[((BYTEIDX*8)+4)];
    SEC_USERCODE[31..30] = SHARED_BUFFER[((BYTEIDX*8)+3)..((BYTEIDX*8)+2)];
    BYTEIDX = 23;
    SEC_UL[59..57] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[3..1] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 24;
    SEC_UL[62..60] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[6..4] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 25;
    SEC_UL[65..63] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[9..7] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 26;
    SEC_UL[68..66] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[12..10] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 27;
    SEC_UL[71..69] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[15..13] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 28;
    SEC_UL[74..72] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    BYTEIDX = 29;
    SEC_UL[77..75] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    BYTEIDX = 30;
    SEC_UL[80..78] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[18..16] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 31;
    SEC_UL[83..81] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[21..19] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 32;
    SEC_UL[86..84] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[24..22] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 33;
    SEC_UL[89..87] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[27..25] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 34;
    SEC_UL[92..90] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[30..28] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 35;
    SEC_UL[95..93] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[33..31] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 36;
    SEC_DL[2..0] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[36..34] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 37;
    SEC_DL[5..3] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[39..37] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 38;
    SEC_DL[8..6] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[42..40] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 39;
    SEC_DL[11..9] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[45..43] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_CERTIFICATE USES GV,CONSTBLOCK,DO_EXIT,READ_SHARED_BUFFER;
    PASS = 0;
    BOOLEAN READ_CERT_RESULT[8];
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $a2;
    WAIT IDLE, 1 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE READ_CERT_RESULT[7..0];
        IF ( ! (READ_CERT_RESULT[7]==0) ) THEN GOTO READ_CERT_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_CERT_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_CERT_DONE;
        IRSCAN 8, $a2;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_CERT_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! ( (ACTIONTYPE==ACTION_READ_DEV_CERT)&&(PASS==0)) ) THEN GOTO READ_CERT_PASSED;
    PRINT "Failed to read device certificate, device is busy";
    STATUS = -38;
    UNIQUEEXITCODE = 32852;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    READ_CERT_PASSED:
    IF ( ! (READ_CERT_RESULT[0]==1) ) THEN GOTO READ_CERT_INVALID;
    IBLOCKS = 48;
    CALL READ_SHARED_BUFFER;
    IF ( ! (DUMPDEVCERTINFO==1) ) THEN GOTO DONTDISPLAY;
    IF ( ! (SHARED_BUFFER[4472]==1) ) THEN GOTO NOTSF2PART;
    PRINT "Family: SmartFusion2";
    NOTSF2PART:
    IF ( ! (SHARED_BUFFER[4472]==0) ) THEN GOTO NOTIGLOO2PART;
    PRINT "Family: Igloo2";
    NOTIGLOO2PART:
    PRINT "Product: ",CHR$(INT(SHARED_BUFFER[1567..1560])),CHR$(INT(SHARED_BUFFER[1575..1568]))
        ,CHR$(INT(SHARED_BUFFER[1583..1576])),CHR$(INT(SHARED_BUFFER[1591..1584]))
        ,CHR$(INT(SHARED_BUFFER[1599..1592])),CHR$(INT(SHARED_BUFFER[1607..1600]))
        ,CHR$(INT(SHARED_BUFFER[1615..1608])),CHR$(INT(SHARED_BUFFER[1623..1616]))
        ,CHR$(INT(SHARED_BUFFER[1631..1624])),CHR$(INT(SHARED_BUFFER[1639..1632]))
        ,CHR$(INT(SHARED_BUFFER[1647..1640])),CHR$(INT(SHARED_BUFFER[1655..1648]))
        ,CHR$(INT(SHARED_BUFFER[1663..1656])),CHR$(INT(SHARED_BUFFER[1671..1664]))
        ,CHR$(INT(SHARED_BUFFER[1679..1672])),CHR$(INT(SHARED_BUFFER[1687..1680]))
        ,CHR$(INT(SHARED_BUFFER[1695..1688])),CHR$(INT(SHARED_BUFFER[1703..1696]))
        ,CHR$(INT(SHARED_BUFFER[1711..1704])),CHR$(INT(SHARED_BUFFER[1719..1712]))
        ,CHR$(INT(SHARED_BUFFER[1727..1720])),CHR$(INT(SHARED_BUFFER[1735..1728]))
        ,CHR$(INT(SHARED_BUFFER[1743..1736])),CHR$(INT(SHARED_BUFFER[1751..1744]))
        ,CHR$(INT(SHARED_BUFFER[1759..1752])),CHR$(INT(SHARED_BUFFER[1767..1760]))
        ,CHR$(INT(SHARED_BUFFER[1775..1768])),CHR$(INT(SHARED_BUFFER[1783..1776]))
        ,CHR$(INT(SHARED_BUFFER[1791..1784])),CHR$(INT(SHARED_BUFFER[1799..1792]))
        ,CHR$(INT(SHARED_BUFFER[1807..1800])),CHR$(INT(SHARED_BUFFER[1815..1808]))
        ,CHR$(INT(SHARED_BUFFER[1823..1816]));
    IF ( ! (SHARED_BUFFER[4472]==1) ) THEN GOTO NOTM3PART;
    PRINT "Cortex-M3 Enabled (M3_ALLOWED = 1)";
    NOTM3PART:
    IF ( ! (SHARED_BUFFER[4472]==0) ) THEN GOTO M3PART;
    PRINT "Cortex-M3 Disabled (M3_ALLOWED = 0)";
    M3PART:
    BUFF32[15..0] = $ffff;
    IF ( ! (INT(SHARED_BUFFER[4327..4312])!=INT(BUFF32[15..0])) ) THEN GOTO DONT_DISPLAY_GRADE;
    EXPORT "Grade", SHARED_BUFFER[4343..4216];
    DONT_DISPLAY_GRADE:
    LABEL_SEPARATOR = 0;
    DONTDISPLAY:
    IF ( ! (ACTIONTYPE==ACTION_READ_DEV_CERT) ) THEN GOTO DONT_DUMP_ENTIRE_CERT;
    BOOLEAN DEV_CERT_REV_BYTEORDER[6144];
    FOR I = 0 TO 6135 STEP 8;
        DEV_CERT_REV_BYTEORDER[(I+7)..I] = SHARED_BUFFER[(6143-I)..(6136-I)];
    NEXT I;
    EXPORT "DEVICE_CERTIFICATE(LSB->MSB)", DEV_CERT_REV_BYTEORDER[6143..0];
    DONT_DUMP_ENTIRE_CERT:
    LABEL_SEPARATOR = 0;
    READ_CERT_INVALID:
    IF ( ! ( (ACTIONTYPE==ACTION_READ_DEV_CERT)&&(READ_CERT_RESULT[0]==0)) ) THEN GOTO NOT_READ_DEV_CERT;
    STATUS = -38;
    IF ( ! (READ_CERT_RESULT[1]==0) ) THEN GOTO READ_CERT_VALID1;
    PRINT "Device certificate is invalid.";
    UNIQUEEXITCODE = 32850;
    READ_CERT_VALID1:
    IF ( ! (READ_CERT_RESULT[1]==1) ) THEN GOTO READ_CERT_VALID2;
    PRINT "Failed to read device certificate (AHB HRESP error).";
    UNIQUEEXITCODE = 32852;
    READ_CERT_VALID2:
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    NOT_READ_DEV_CERT:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_SET_COFC_SIZE USES GV;
    COFC_FORMAT = 1;
    IF ( ! (INT(ID[27..0])==INT(M2S050[31..0])) ) THEN GOTO NOT_050;
    IF ( ! (IDREV<4) ) THEN GOTO NEW_050;
    COFC_FORMAT = 0;
    NEW_050:
    LABEL_SEPARATOR = 0;
    NOT_050:
    IF ( ! ( ( ( ( (INT(ID[27..0])==INT(M2S010[31..0]))||(INT(ID[27..0])==INT(M2S025[31..0])))||(INT(ID[27..0])==INT(M2S005[31..0])))||(INT(ID[27..0])==INT(M2S150[31..0])))||(INT(ID[27..0])==INT(M2S090[31..0]))) ) THEN GOTO NOT_OLD_COFC_DEVICE;
    IF ( ! (IDREV<1) ) THEN GOTO NEW_REV;
    COFC_FORMAT = 0;
    NEW_REV:
    LABEL_SEPARATOR = 0;
    NOT_OLD_COFC_DEVICE:
    IF ( ! (COFC_FORMAT==1) ) THEN GOTO OLD_COFC1;
    CERTIFICATE_SIZE = 912;
    OLD_COFC1:
    IF ( ! (COFC_FORMAT==0) ) THEN GOTO NEW_COFC;
    CERTIFICATE_SIZE = 656;
    NEW_COFC:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE PROC_ENABLE USES GV,DO_EXIT,SET_PGM_MODE,DO_READ_SECURITY,DO_SET_COFC_SIZE;
    CALL DO_SET_COFC_SIZE;
    CALL SET_PGM_MODE;
    CALL DO_READ_SECURITY;
    BOOLEAN ISC_ENABLE_RESULT[32];
    BPGMMODE = 1;
    PASS = 0;
    BSR[713..0] = BSRPATTERN[713..0];
    BOOLEAN SHIFT_DATA[714];
    IRSCAN 8, $01;
    DRSCAN 714, BSR[];
    WAIT IDLE, 1 CYCLES;
    DRSCAN 714, SHIFT_DATA[], CAPTURE SAMPLE_DEVICE[];
    FOR I = 0 TO 713;
        IF ( ! (SAMPLEMASK[I]==1) ) THEN GOTO NOT_SAMPLE_MASK;
        BSR[I] = SAMPLE_DEVICE[I];
        NOT_SAMPLE_MASK:
        LABEL_SEPARATOR = 0;
    NEXT I;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $01;
    DRSCAN 714, BSR[];
    WAIT IDLE, 1 CYCLES;
    BOOLEAN TOOLINFO[32];
    TOOLINFO[5..0] = ACT_UROW_ALGO_VERSION[5..0];
    TOOLINFO[9..6] = ACT_UROW_PROGRAM_SW[3..0];
    TOOLINFO[22..17] = ACT_UROW_SW_VERSION[5..0];
    TOOLINFO[25..23] = ACT_UROW_PGM_SW[2..0];
    TOOLINFO[28..26] = BOOL(3);
    TOOLINFO[31..29] = BOOL(2);
    IRSCAN 8, $8f, CAPTURE BUFF32[7..0];
    IF ( ! (BUFF32[2]==0) ) THEN GOTO NOT_BLANK_PRE;
    PASS = 0;
    BOOLEAN DPC_RESULT[64];
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $da;
    DRSCAN 64, $0000000004024040;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 64, $0000000000000000, CAPTURE DPC_RESULT[];
        IF ( ! (DPC_RESULT[63]==0) ) THEN GOTO DPC1_POLL;
        IPOLL = 0;
        PASS = 1;
        DPC1_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DPC1_DONE;
        IRSCAN 8, $da;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DPC1_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    NOT_BLANK_PRE:
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $80;
    DRSCAN 32, TOOLINFO[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE ISC_ENABLE_RESULT[31..0];
        IF ( ! (INT(ISC_ENABLE_RESULT[23..0])==INT(TOOLINFO[23..0])) ) THEN GOTO JTAG_NOT_LOCKED;
        PRINT "JTAG interface is protected by UPK1";
        STATUS = -30;
        UNIQUEEXITCODE = 32815;
        BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
        EXPORT "ERROR_CODE", BUFF32[15..0];
        CALL DO_EXIT;
        JTAG_NOT_LOCKED:
        IF ( ! (ISC_ENABLE_RESULT[31]==0) ) THEN GOTO ISC_ENABLE_POLL;
        IPOLL = 0;
        PASS = 1;
        ISC_ENABLE_POLL:
        IF ( ! (PASS==0) ) THEN GOTO ISC_ENABLE_DONE;
        IRSCAN 8, $80;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        ISC_ENABLE_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    EXPORT "ISC_ENABLE_RESULT", ISC_ENABLE_RESULT[];
    EXPORT "CRCERR", ISC_ENABLE_RESULT[0..0];
    EXPORT "EDCERR", ISC_ENABLE_RESULT[1..1];
    IF ( ! (PASS==0) ) THEN GOTO ISC_ENABLE_NOT_TIMED_OUT;
    PRINT "Instruction timed out while entering programming mode.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    ISC_ENABLE_NOT_TIMED_OUT:
    IF ( ! ( ( (PASS==1)&&(ISC_ENABLE_RESULT[0]==1))||( (PASS==1)&&(INT(ISC_ENABLE_RESULT[31..0])==0))) ) THEN GOTO ISC_ENABLE_PASS;
    PRINT "Failed to enter programming mode.";
    STATUS = 5;
    UNIQUEEXITCODE = 32771;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    ISC_ENABLE_PASS:
    IRSCAN 8, $8f, CAPTURE BUFF32[7..0];
    IF ( ! (BUFF32[2]==0) ) THEN GOTO NOT_BLANK_POST;
    PASS = 0;
    DPC_RESULT[63..0] = $0000000000000000;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $da;
    DRSCAN 64, $0000000004024840;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 64, $0000000000000000, CAPTURE DPC_RESULT[];
        IF ( ! (DPC_RESULT[63]==0) ) THEN GOTO DPC2_POLL;
        IPOLL = 0;
        PASS = 1;
        DPC2_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DPC2_DONE;
        IRSCAN 8, $da;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DPC2_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    NOT_BLANK_POST:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE PRINT_IDCODE USES GV;
    EXPORT "IDCODE", ID[];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE VERIFY_IDCODE USES GV,PARAMETERS,DO_EXIT,POLL_DEVICE_READY;
    FREQUENCY (FREQ*1000000);
    WAIT RESET, 5 CYCLES;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $0f;
    DRSCAN 32, $00000000;
    WAIT IDLE, 1 CYCLES;
    DRSCAN 32, $00000000, CAPTURE ID[],COMPARE IDCODEVALUE[],IDMASK[],PASS;
    IF ( ! (PASS==0) ) THEN GOTO IDOK;
    STATUS = 6;
    UNIQUEEXITCODE = 32772;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    PRINT "Failed to verify IDCODE";
    CALL DO_EXIT;
    IDOK:
    IDREV = INT(ID[31..28]);
    CALL POLL_DEVICE_READY;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE GET_DATA_STATUS USES GV,DO_EXIT;
    INTEGER IPOLLDATA =0;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $c9;
    DRSCAN 32, $00000000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLLDATA = 27777 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE DATA_STATUS_RESULT[31..0];
        IF ( ! (DATA_STATUS_RESULT[31]==0) ) THEN GOTO DATA_STATUS_POLL;
        IPOLLDATA = 0;
        PASS = 1;
        DATA_STATUS_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DATA_STATUS_READ;
        IRSCAN 8, $c9;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DATA_STATUS_READ:
        LABEL_SEPARATOR = 0;
    NEXT IPOLLDATA;
    IF ( ! (PASS==0) ) THEN GOTO GET_DATA_NOT_TIMED_OUT;
    PRINT "Instruction timed out while reading datablock status.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    GET_DATA_NOT_TIMED_OUT:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE READ_CERTIFICATE USES GV,READ_SHARED_BUFFER;
    IBLOCKS = (CERTIFICATE_SIZE/128);
    IF ( ! ((CERTIFICATE_SIZE%128)!=0) ) THEN GOTO NO_INCOM_BLOCK;
    IBLOCKS = (IBLOCKS+1);
    NO_INCOM_BLOCK:
    CALL READ_SHARED_BUFFER;
    COMPONENTDIGEST[255..0] = SHARED_BUFFER[399..144];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE PROCESS_DATA USES BITSTREAM,GV,CONSTBLOCK,DO_EXIT,GET_DATA_STATUS,READ_CERTIFICATE;
    BOOLEAN DATA_SHIFT_RESULT[128];
    INTEGER BLOCKNO =0;
    INTEGER CURRNUMOFBLOCKS =0;
    INTEGER COMPONENTNO =0;
    INTEGER TOTALNUMOFBLOCKS =0;
    INTEGER TOTALCURRBLOCK =0;
    IF ( ! (ICURNUMOFCOMPONENTS>ICURCOMPONENTNO) ) THEN GOTO DONT_UPDATE_BAR;
    FOR COMPONENTNO = (ICURCOMPONENTNO+1) TO ICURNUMOFCOMPONENTS STEP 1;
        CURRNUMOFBLOCKS = INT(NUMOFBLOCKS[((COMPONENTNO*22)-1)..((COMPONENTNO-1)*22)]);
        TOTALNUMOFBLOCKS = (TOTALNUMOFBLOCKS+CURRNUMOFBLOCKS);
    NEXT COMPONENTNO;
    DONT_UPDATE_BAR:
    FOR COMPONENTNO = ICURCOMPONENTNO TO ICURNUMOFCOMPONENTS STEP 1;
        IRSCAN 8, $ee;
        DRSCAN 128, DATASTREAM[(DATAINDEX+127)..DATAINDEX];
        COMPONENETSUPPORTSCERT = 0;
        COMPTYPE = COMP_UNDEF;
        CURRNUMOFBLOCKS = INT(NUMOFBLOCKS[((COMPONENTNO*22)-1)..((COMPONENTNO-1)*22)]);
        FOR BLOCKNO = 1 TO CURRNUMOFBLOCKS STEP 1;
            IF ( ! (COMPONENTNO!=ICURCOMPONENTNO) ) THEN GOTO FIRST_COMP;
            TOTALCURRBLOCK = (TOTALCURRBLOCK+1);
            FIRST_COMP:
            IF ( ! (BLOCKNO==4) ) THEN GOTO NOT_FOURTH_BLOCK;
            COMPTYPE = INT(DATASTREAM[(DATAINDEX+7)..DATAINDEX]);
            NOT_FOURTH_BLOCK:
            IF ( ! (BLOCKNO==1) ) THEN GOTO NOT_FIRST_BLOCK1;
            COMPONENETSUPPORTSCERT = INT(DATASTREAM[(DATAINDEX+2721)..(DATAINDEX+2721)]);
            NOT_FIRST_BLOCK1:
            PASS = 0;
            WAIT 45 USEC, DRPAUSE;
            FOR IPOLL = 510000 TO 0 STEP -1;
                IF ( ! (IPOLL==510000) ) THEN GOTO NOT_FIRST_POLL;
                IF ( ! (COMPTYPE==COMP_BITS) ) THEN GOTO NOT_COMP_0;
                IF ( ! (SEC_UCNFG[12]==1) ) THEN GOTO RECOVERY_ENABLED;
                IPOLL = 250000;
                RECOVERY_ENABLED:
                LABEL_SEPARATOR = 0;
                NOT_COMP_0:
                IF ( ! (COMPTYPE!=0) ) THEN GOTO COMP_0;
                IPOLL = 83333;
                COMP_0:
                LABEL_SEPARATOR = 0;
                NOT_FIRST_POLL:
                IF ( ! ( (COMPONENTNO!=ICURNUMOFCOMPONENTS)||(BLOCKNO!=CURRNUMOFBLOCKS)) ) THEN GOTO LAST_BLOCK;
                DRSCAN 128, DATASTREAM[(DATAINDEX+255)..(DATAINDEX+128)], CAPTURE DATA_SHIFT_RESULT[127..0];
                LAST_BLOCK:
                IF ( ! ( (COMPONENTNO==ICURNUMOFCOMPONENTS)&&(BLOCKNO==CURRNUMOFBLOCKS)) ) THEN GOTO NOT_LAST_BLOCK;
                DRSCAN 128, DATASTREAM[(DATAINDEX+127)..DATAINDEX], CAPTURE DATA_SHIFT_RESULT[127..0];
                NOT_LAST_BLOCK:
                IF ( ! (DATA_SHIFT_RESULT[127]==0) ) THEN GOTO DATA_POLL;
                IPOLL = 0;
                PASS = 1;
                DATA_POLL:
                IF ( ! (PASS==0) ) THEN GOTO DATA_DONE;
                IRSCAN 8, $ee;
                WAIT IRPAUSE, 10 USEC, IRPAUSE;
                DATA_DONE:
                LABEL_SEPARATOR = 0;
            NEXT IPOLL;
            IF ( ! ( (PASS==0)||( (PASS==1)&&( (DATA_SHIFT_RESULT[3]==1)||(DATA_SHIFT_RESULT[4]==1)))) ) THEN GOTO DATA_PASS;
            IF ( ! (PASS==0) ) THEN GOTO POLL_COMPLETED;
            PRINT "Instruction timed out.";
            PRINT "componentNo: ",COMPONENTNO;
            PRINT "blockNo: ",BLOCKNO;
            STATUS = -32;
            UNIQUEEXITCODE = 32818;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            CALL DO_EXIT;
            POLL_COMPLETED:
            CALL GET_DATA_STATUS;
            IF ( ! ( (PASS==1)&&(DATA_STATUS_RESULT[2]==1)) ) THEN GOTO NO_ERROR_PER_BLOCK;
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])!=0) ) THEN GOTO NOT_AUTHERR;
            PRINT "Authentication Error.";
            IF ( ! ( ( ( (INT(DATA_STATUS_RESULT[15..8])==1)||(INT(DATA_STATUS_RESULT[15..8])==2))||(INT(DATA_STATUS_RESULT[15..8])==4))||(INT(DATA_STATUS_RESULT[15..8])==8)) ) THEN GOTO NOT_INVALID_BITSTREAM;
            PRINT "Bitstream or data is corrupted or noisy.";
            STATUS = -22;
            UNIQUEEXITCODE = 32799;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_INVALID_BITSTREAM:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==3) ) THEN GOTO ENC_KEY_SATISFIED;
            PRINT "Invalid/Corrupted encryption key.";
            STATUS = -23;
            UNIQUEEXITCODE = 32801;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            ENC_KEY_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==5) ) THEN GOTO BACKLEVEL_SATISFIED;
            PRINT "Back level not satisfied.";
            STATUS = -24;
            UNIQUEEXITCODE = 32803;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            BACKLEVEL_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==7) ) THEN GOTO DSN_SATISFIED;
            PRINT "DSN binding mismatch";
            STATUS = -25;
            UNIQUEEXITCODE = 32805;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DSN_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==9) ) THEN GOTO DEVCAP_SATISFIED;
            PRINT "Bitstream and device mismatch";
            STATUS = -26;
            UNIQUEEXITCODE = 32807;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DEVCAP_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==10) ) THEN GOTO CORRECT_IDCODE;
            PRINT "Incorrect DEVICEID.";
            STATUS = -27;
            UNIQUEEXITCODE = 32809;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            CORRECT_IDCODE:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==11) ) THEN GOTO BITSTREAM_FINE;
            PRINT "Signal integrity issues on JTAG pins, please check.";
            STATUS = -28;
            UNIQUEEXITCODE = 32811;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            BITSTREAM_FINE:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==12) ) THEN GOTO BITSTREAM_VER;
            PRINT "Programming file does not support verification.";
            STATUS = -29;
            UNIQUEEXITCODE = 32813;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            BITSTREAM_VER:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==13) ) THEN GOTO DEVCAP_ACCESS;
            PRINT "Invalid or inaccessible Device Certificate.";
            STATUS = -31;
            UNIQUEEXITCODE = 32816;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DEVCAP_ACCESS:
            LABEL_SEPARATOR = 0;
            NOT_AUTHERR:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])!=0) ) THEN GOTO NOT_ERRORCODE;
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==5) ) THEN GOTO NOT_NVMVERIFY;
            IF ( ! (PREPARING_BITSTREAM==0) ) THEN GOTO SKIP_VERIFYNVM_DISP;
            PRINT "Failed to verify eNVM.";
            STATUS = 11;
            UNIQUEEXITCODE = 32776;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            SKIP_VERIFYNVM_DISP:
            LABEL_SEPARATOR = 0;
            NOT_NVMVERIFY:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==4) ) THEN GOTO NOT_NVMPRG;
            PRINT "Failed to program eNVM.";
            STATUS = 10;
            UNIQUEEXITCODE = 32773;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_NVMPRG:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==2) ) THEN GOTO DEVICE_NO_SEC;
            PRINT "Device security prevented operation.";
            STATUS = -21;
            UNIQUEEXITCODE = 32797;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DEVICE_NO_SEC:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==1) ) THEN GOTO FABRIC_VER_FINE;
            IF ( ! (PREPARING_BITSTREAM==0) ) THEN GOTO SKIP_VERIFY_DISP;
            IF ( ! (INT(DATA_STATUS_RESULT[23..16])==248) ) THEN GOTO NOT_FC;
            PRINT "Failed to verify Fabric Configuration.";
            NOT_FC:
            IF ( ! ( ( (INT(DATA_STATUS_RESULT[23..16])==249)||(INT(DATA_STATUS_RESULT[23..16])==250))||(INT(DATA_STATUS_RESULT[23..16])==251)) ) THEN GOTO NOT_SEC;
            PRINT "Failed to verify Security.";
            NOT_SEC:
            IF ( ! ( ( ( (INT(DATA_STATUS_RESULT[23..16])!=248)&&(INT(DATA_STATUS_RESULT[23..16])!=249))&&(INT(DATA_STATUS_RESULT[23..16])!=250))&&(INT(DATA_STATUS_RESULT[23..16])!=251)) ) THEN GOTO NOT_FABRIC;
            PRINT "Failed to verify FPGA Array.";
            NOT_FABRIC:
            STATUS = 11;
            UNIQUEEXITCODE = 32775;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            SKIP_VERIFY_DISP:
            LABEL_SEPARATOR = 0;
            FABRIC_VER_FINE:
            LABEL_SEPARATOR = 0;
            NOT_ERRORCODE:
            IF ( ! ( (PREPARING_BITSTREAM==0)||(INT(DATA_STATUS_RESULT[15..8])!=0)) ) THEN GOTO SKIP_VERIFY_EXIT;
            IF ( ! (COMPTYPE==COMP_BITS) ) THEN GOTO NOT_BITS_COMP;
            PRINT "Component: BITS";
            NOT_BITS_COMP:
            IF ( ! (COMPTYPE==COMP_FPGA) ) THEN GOTO NOT_FPGA_COMP;
            PRINT "Component: FPGA";
            NOT_FPGA_COMP:
            IF ( ! (COMPTYPE==COMP_KEYS) ) THEN GOTO NOT_SEC_COMP;
            PRINT "Component: Security";
            NOT_SEC_COMP:
            IF ( ! (COMPTYPE==COMP_ENVM) ) THEN GOTO NOT_ENVM_COMP;
            PRINT "Component: eNVM";
            NOT_ENVM_COMP:
            IF ( ! (COMPTYPE==COMP_EOB) ) THEN GOTO NOT_EOB_COMP;
            PRINT "Component: EOB";
            NOT_EOB_COMP:
            PRINT "componentNo: ",COMPONENTNO;
            PRINT "blockNo: ",BLOCKNO;
            EXPORT "DATA_STATUS_RESULT: ", DATA_STATUS_RESULT[31..0];
            CALL DO_EXIT;
            SKIP_VERIFY_EXIT:
            LABEL_SEPARATOR = 0;
            NO_ERROR_PER_BLOCK:
            LABEL_SEPARATOR = 0;
            DATA_PASS:
            IF ( ! ( (COMPONENTNO!=ICURCOMPONENTNO)&&((TOTALCURRBLOCK%1500)==0)) ) THEN GOTO DONT_UPDATE_PERCENTAGE;
            PERCENT_UPDATE = ((100*TOTALCURRBLOCK)/TOTALNUMOFBLOCKS);
            EXPORT "PERCENT_DONE", PERCENT_UPDATE;
            DONT_UPDATE_PERCENTAGE:
            DATAINDEX = (DATAINDEX+128);
        NEXT BLOCKNO;
        IF ( ! ( (ACTIONTYPE==ACTION_PROG)&&(COMPONENETSUPPORTSCERT==1)) ) THEN GOTO DONT_DUMP_DIGEST1;
        IF ( ! (COMPTYPE==COMP_FPGA) ) THEN GOTO DUMMY2;
        CALL READ_CERTIFICATE;
        EXPORT "Fabric component bitstream digest", COMPONENTDIGEST[];
        DUMMY2:
        IF ( ! (COMPTYPE==COMP_ENVM) ) THEN GOTO DUMMY4;
        CALL READ_CERTIFICATE;
        EXPORT "eNVM_0 component bitstream digest", COMPONENTDIGEST[];
        DUMMY4:
        LABEL_SEPARATOR = 0;
        DONT_DUMP_DIGEST1:
        LABEL_SEPARATOR = 0;
    NEXT COMPONENTNO;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SET_MODE USES GV,DO_EXIT,LOAD_AUXLO;
    IF ( ! (COFC_FORMAT==1) ) THEN GOTO OLD_COFC2;
    AUXLO_REG[127..0] = COFC_NONCE[127..0];
    CALL LOAD_AUXLO;
    OLD_COFC2:
    BOOLEAN DATA_INIT_RESULT[8];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $ae;
    DRSCAN 8, PGMMODE[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE DATA_INIT_RESULT[7..0];
        IF ( ! (DATA_INIT_RESULT[7]==0) ) THEN GOTO DATA_INIT_POLL;
        IPOLL = 0;
        PASS = 1;
        DATA_INIT_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DATA_INIT_DONE;
        IRSCAN 8, $ae;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DATA_INIT_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO DATA_INIT_PASSED;
    PRINT "Instruction timed out while setting programming mode.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    DATA_INIT_PASSED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_ERASE USES GV,PROCESS_DATA,SET_MODE;
    PRINT "Erasing FPGA Array...";
    PGMMODE[7..0] = $01;
    CALL SET_MODE;
    DATAINDEX = DATAERASESTARTINDEX;
    ICURCOMPONENTNO = ((DATASIZE+DATAENVMSIZE)+1);
    ICURNUMOFCOMPONENTS = ((DATASIZE+DATAENVMSIZE)+DATAERASESIZE);
    CALL PROCESS_DATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_PREPARE_BITSTREAM USES GV,CONSTBLOCK,PROCESS_DATA,SET_MODE;
    PREPARING_BITSTREAM = 1;
    PGMMODE[7..0] = $02;
    CALL SET_MODE;
    ORIGACTIONTYPE = ACTIONTYPE;
    ACTIONTYPE = ACTION_VER;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = 2;
    DATAINDEX = DATASTARTINDEX;
    PREV_NUM_OF_BLOCKS = INT(NUMOFBLOCKS[43..22]);
    BUFF32[31..0] = BOOL(91);
    NUMOFBLOCKS[43..22] = BUFF32[21..0];
    CALL PROCESS_DATA;
    NUMOFBLOCKS[43..22] = BOOL(PREV_NUM_OF_BLOCKS);
    PREPARING_BITSTREAM = 0;
    ACTIONTYPE = ORIGACTIONTYPE;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_VERIFY USES GV,PROCESS_DATA,SET_MODE;
    IF ( ! (RANPROGRAMMINGACTION==1) ) THEN GOTO RAN_PROGRAM;
    RANPROGRAMMINGACTION = 0;
    RAN_PROGRAM:
    PRINT "Verifying FPGA Array and eNVM...";
    PGMMODE[7..0] = $02;
    CALL SET_MODE;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = DATASIZE;
    DATAINDEX = DATASTARTINDEX;
    CALL PROCESS_DATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_AUTHENTICATION USES GV,PROCESS_DATA,SET_MODE;
    PRINT "Encrypted data authentication...";
    PGMMODE[7..0] = $00;
    CALL SET_MODE;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = DATASIZE;
    DATAINDEX = DATASTARTINDEX;
    CALL PROCESS_DATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DUMP_PROGRAMMING_INTERFACE USES GV,CONSTBLOCK;
    INTEGER PROGRAMMODE =0;
    BUFF32[31..0] = READ_PROG_INFO_RESULT[95..64];
    PROGRAMMODE = INT(BUFF32[28..26]);
    IF ( ! (PROGRAMMODE==SPI_MASTER) ) THEN GOTO NOT_SPI_MASTER;
    PRINT "Programming Interface Protocol: SPI Master";
    NOT_SPI_MASTER:
    IF ( ! (PROGRAMMODE==SPI_SLAVE) ) THEN GOTO NOT_SPI_SLAVE;
    PRINT "Programming Interface Protocol: SPI Slave";
    NOT_SPI_SLAVE:
    IF ( ! (PROGRAMMODE==JTAG) ) THEN GOTO NOT_JTAG;
    PRINT "Programming Interface Protocol: JTAG";
    NOT_JTAG:
    IF ( ! ( (PROGRAMMODE==0)||(PROGRAMMODE>3)) ) THEN GOTO Label_0;
    PRINT "Programming Interface Protocol:";
    Label_0:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DUMP_PROG_INFO USES GV,CONSTBLOCK,DUMP_PROGRAMMING_INTERFACE;
    INTEGER TMPINT =0;
    BUFF32[31..0] = READ_PROG_INFO_RESULT[95..64];
    IF ( ! (INT(READ_PROG_INFO_RESULT[15..0])!=65535) ) THEN GOTO UNKNOWN_CYCLE_COUNT;
    PRINT "CYCLE COUNT: ",INT(READ_PROG_INFO_RESULT[15..0]);
    UNKNOWN_CYCLE_COUNT:
    IF ( ! (INT(READ_PROG_INFO_RESULT[15..0])==65535) ) THEN GOTO KNOWN_CYCLE_COUNT;
    PRINT "CYCLE COUNT: Not available";
    KNOWN_CYCLE_COUNT:
    EXPORT "PROG_INFO", READ_PROG_INFO_RESULT[127..0];
    TMPINT = INT(READ_PROG_INFO_RESULT[48..48]);
    IF ( ! (TMPINT==0) ) THEN GOTO NOT_12;
    PRINT "VCC was programmed at 1.2V";
    NOT_12:
    IF ( ! (TMPINT==1) ) THEN GOTO NOT_10;
    PRINT "VCC was programmed at 1.0V";
    NOT_10:
    PRINT "Warning: Algorithm Version, Programmer, Software Version, Programming Software
        , Programming Interface Protocol, and Programming File Type information do not get programmed with Auto Programming
        , Auto Update (IAP), Programming Recovery, or IAP/ISP Services and should be ignored.";
    TMPINT = INT(BUFF32[5..0]);
    IF ( ! ( (TMPINT==0)||(TMPINT==63)) ) THEN GOTO NOT_UNDEF;
    PRINT "Algorithm Version:";
    NOT_UNDEF:
    IF ( ! ( (TMPINT!=0)&&(TMPINT!=63)) ) THEN GOTO UNDEF;
    PRINT "Algorithm Version: ",INT(BUFF32[5..0]);
    UNDEF:
    TMPINT = INT(BUFF32[9..6]);
    IF ( ! (TMPINT==SELF) ) THEN GOTO NOT_SELF;
    PRINT "Programmer: SPI Master Auto Programming";
    NOT_SELF:
    IF ( ! (TMPINT==SCULPTW) ) THEN GOTO NOT_SCULPTW;
    PRINT "Programmer: Silicon Sculptor II/III";
    NOT_SCULPTW:
    IF ( ! (TMPINT==BPWIN) ) THEN GOTO NOT_BPW;
    PRINT "Programmer: BP Programmer";
    NOT_BPW:
    IF ( ! (TMPINT==MICROSEMI_IHP) ) THEN GOTO NOT_MICROSEMI_IHP;
    PRINT "Programmer: Microsemi IHP";
    NOT_MICROSEMI_IHP:
    IF ( ! (TMPINT==FP3) ) THEN GOTO NOT_FP3;
    PRINT "Programmer: FlashPro3";
    NOT_FP3:
    IF ( ! (TMPINT==FP4) ) THEN GOTO NOT_FP4;
    PRINT "Programmer: FlashPro4";
    NOT_FP4:
    IF ( ! (TMPINT==FP5) ) THEN GOTO NOT_FP5;
    PRINT "Programmer: FlashPro5";
    NOT_FP5:
    IF ( ! (TMPINT==FP6) ) THEN GOTO NOT_FP6;
    PRINT "Programmer: FlashPro6";
    NOT_FP6:
    IF ( ! (TMPINT==EFP6) ) THEN GOTO NOT_EFP6;
    PRINT "Programmer: Embedded FlashPro6";
    NOT_EFP6:
    IF ( ! (TMPINT==SIL_EXPL) ) THEN GOTO NOT_SIL_EXPL;
    PRINT "Programmer: Silicon Explorer";
    NOT_SIL_EXPL:
    IF ( ! (TMPINT==ATE) ) THEN GOTO NOT_ATE;
    PRINT "Programmer: Non Microsemi Programmer";
    NOT_ATE:
    IF ( ! ( (TMPINT==0)||(TMPINT==15)) ) THEN GOTO UNDEF_P_T;
    PRINT "Programmer:";
    UNDEF_P_T:
    TMPINT = INT(BUFF32[22..17]);
    IF ( ! (TMPINT==FP34) ) THEN GOTO NOT_FP34;
    PRINT "Software Version: FlashPro v3.4";
    NOT_FP34:
    IF ( ! (TMPINT==FP40) ) THEN GOTO NOT_FP40;
    PRINT "Software Version: FlashPro v4.0";
    NOT_FP40:
    IF ( ! (TMPINT==FP41) ) THEN GOTO NOT_FP41;
    PRINT "Software Version: FlashPro v4.1";
    NOT_FP41:
    IF ( ! (TMPINT==FP42) ) THEN GOTO NOT_FP42;
    PRINT "Software Version: FlashPro v4.2";
    NOT_FP42:
    IF ( ! (TMPINT==FP50) ) THEN GOTO NOT_FP50;
    PRINT "Software Version: FlashPro v5.0";
    NOT_FP50:
    IF ( ! (TMPINT==FP51) ) THEN GOTO NOT_FP51;
    PRINT "Software Version: FlashPro v5.1";
    NOT_FP51:
    IF ( ! (TMPINT==FP60) ) THEN GOTO NOT_FP60;
    PRINT "Software Version: FlashPro v6.0";
    NOT_FP60:
    IF ( ! (TMPINT==FP61) ) THEN GOTO NOT_FP61;
    PRINT "Software Version: FlashPro v6.1";
    NOT_FP61:
    IF ( ! (TMPINT==FP62) ) THEN GOTO NOT_FP62;
    PRINT "Software Version: FlashPro v6.2";
    NOT_FP62:
    IF ( ! (TMPINT==FP84) ) THEN GOTO NOT_FP84;
    PRINT "Software Version: FlashPro v8.4";
    NOT_FP84:
    IF ( ! (TMPINT==FP85) ) THEN GOTO NOT_FP85;
    PRINT "Software Version: FlashPro v8.5";
    NOT_FP85:
    IF ( ! (TMPINT==FP86) ) THEN GOTO NOT_FP86;
    PRINT "Software Version: FlashPro v8.6";
    NOT_FP86:
    IF ( ! (TMPINT==FP90) ) THEN GOTO NOT_FP90;
    PRINT "Software Version: FlashPro v9.0";
    NOT_FP90:
    IF ( ! (TMPINT==FP91) ) THEN GOTO NOT_FP91;
    PRINT "Software Version: FlashPro v9.1";
    NOT_FP91:
    IF ( ! (TMPINT==FP_10_LCP) ) THEN GOTO NOT_10_LCP;
    PRINT "Software Version: FlashPro 10.0 LCP";
    NOT_10_LCP:
    IF ( ! (TMPINT==FP_11_BETA_SPA) ) THEN GOTO NOT_11_BETA_SPA;
    PRINT "Software Version: FlashPro 11.0 Beta SPA";
    NOT_11_BETA_SPA:
    IF ( ! (TMPINT==FP_11_BETA_SP1) ) THEN GOTO NOT_11_BETA_SP1;
    PRINT "Software Version: FlashPro 11.0 Beta SP1";
    NOT_11_BETA_SP1:
    IF ( ! (TMPINT==FP_11) ) THEN GOTO NOT_11;
    PRINT "Software Version: FlashPro 11.0";
    NOT_11:
    IF ( ! (TMPINT==FP_11_1) ) THEN GOTO NOT_11_1;
    PRINT "Software Version: FlashPro 11.1";
    NOT_11_1:
    IF ( ! (TMPINT==FP_11_2) ) THEN GOTO NOT_11_2;
    PRINT "Software Version: FlashPro 11.2";
    NOT_11_2:
    IF ( ! (TMPINT==FP_11_3) ) THEN GOTO NOT_11_3;
    PRINT "Software Version: FlashPro 11.3";
    NOT_11_3:
    IF ( ! (TMPINT==FP_11_4) ) THEN GOTO NOT_11_4;
    PRINT "Software Version: 11.4";
    NOT_11_4:
    IF ( ! (TMPINT==FP_11_5) ) THEN GOTO NOT_11_5;
    PRINT "Software Version: 11.5";
    NOT_11_5:
    IF ( ! (TMPINT==FP_11_6) ) THEN GOTO NOT_11_6;
    PRINT "Software Version: 11.6";
    NOT_11_6:
    IF ( ! (TMPINT==FP_11_7) ) THEN GOTO NOT_11_7;
    PRINT "Software Version: 11.7";
    NOT_11_7:
    IF ( ! (TMPINT==FP_11_8) ) THEN GOTO NOT_11_8;
    PRINT "Software Version: 11.8";
    NOT_11_8:
    IF ( ! (TMPINT==FP_11_9) ) THEN GOTO NOT_FP_11_9;
    PRINT "Software Version: 11.9";
    NOT_FP_11_9:
    IF ( ! (TMPINT==FP_12_0) ) THEN GOTO NOT_FP_12_0;
    PRINT "Software Version: 12.0";
    NOT_FP_12_0:
    IF ( ! (TMPINT==FP_12_1) ) THEN GOTO NOT_FP_12_1;
    PRINT "Software Version: 12.1";
    NOT_FP_12_1:
    IF ( ! (TMPINT==FP_12_2) ) THEN GOTO NOT_FP_12_2;
    PRINT "Software Version: 12.2";
    NOT_FP_12_2:
    IF ( ! (TMPINT==FP_12_3) ) THEN GOTO NOT_FP_12_3;
    PRINT "Software Version: 12.3";
    NOT_FP_12_3:
    IF ( ! (TMPINT==FP_12_4) ) THEN GOTO NOT_FP_12_4;
    PRINT "Software Version: 12.4";
    NOT_FP_12_4:
    IF ( ! (TMPINT==FP_12_5) ) THEN GOTO NOT_FP_12_5;
    PRINT "Software Version: 12.5";
    NOT_FP_12_5:
    IF ( ! (TMPINT==FP_12_6) ) THEN GOTO NOT_FP_12_6;
    PRINT "Software Version: 12.6";
    NOT_FP_12_6:
    IF ( ! (TMPINT==FP_2021_1) ) THEN GOTO NOT_FP_2021_1;
    PRINT "Software Version: 2021.1";
    NOT_FP_2021_1:
    IF ( ! (TMPINT==FP_2021_2) ) THEN GOTO NOT_FP_2021_2;
    PRINT "Software Version: 2021.2";
    NOT_FP_2021_2:
    IF ( ! (TMPINT==FP_2021_3) ) THEN GOTO NOT_FP_2021_3;
    PRINT "Software Version: 2021.3";
    NOT_FP_2021_3:
    IF ( ! (TMPINT==FP_2022_1) ) THEN GOTO NOT_FP_2022_1;
    PRINT "Software Version: 2022.1";
    NOT_FP_2022_1:
    IF ( ! (TMPINT==FP_2022_2) ) THEN GOTO NOT_FP_2022_2;
    PRINT "Software Version: 2022.2";
    NOT_FP_2022_2:
    IF ( ! (TMPINT==FP_2022_3) ) THEN GOTO NOT_FP_2022_3;
    PRINT "Software Version: 2022.3";
    NOT_FP_2022_3:
    IF ( ! (TMPINT==FP_2023_1) ) THEN GOTO NOT_FP_2023_1;
    PRINT "Software Version: 2023.1";
    NOT_FP_2023_1:
    IF ( ! (TMPINT==FP_2023_2) ) THEN GOTO NOT_FP_2023_2;
    PRINT "Software Version: 2023.2";
    NOT_FP_2023_2:
    IF ( ! (TMPINT==FP_2024_1) ) THEN GOTO NOT_FP_2024_1;
    PRINT "Software Version: 2024.1";
    NOT_FP_2024_1:
    IF ( ! (TMPINT==FP_2024_2) ) THEN GOTO NOT_FP_2024_2;
    PRINT "Software Version: 2024.2";
    NOT_FP_2024_2:
    IF ( ! ( (TMPINT==0)||(TMPINT==63)) ) THEN GOTO NOT_UNDEF_SOFT_VER;
    PRINT "Software Version:";
    NOT_UNDEF_SOFT_VER:
    TMPINT = INT(BUFF32[25..23]);
    IF ( ! (TMPINT==FP) ) THEN GOTO NOT_FP;
    PRINT "Programming Software: FlashPro";
    NOT_FP:
    IF ( ! (TMPINT==DIRECTC) ) THEN GOTO NOT_DC;
    PRINT "Programming Software: Direct C";
    NOT_DC:
    IF ( ! (TMPINT==FPX) ) THEN GOTO NOT_FPX;
    PRINT "Programming Software: FlashPro Express";
    NOT_FPX:
    IF ( ! (TMPINT==NON_MICROSEMI) ) THEN GOTO NOT_NON_MICROSEMI;
    PRINT "Programming Software: Non Microsemi SW";
    NOT_NON_MICROSEMI:
    IF ( ! ( (TMPINT==0)||(TMPINT==7)) ) THEN GOTO UNDEF_P_S;
    PRINT "Programming Software:";
    UNDEF_P_S:
    CALL DUMP_PROGRAMMING_INTERFACE;
    TMPINT = INT(BUFF32[31..29]);
    IF ( ! (TMPINT==PPD) ) THEN GOTO NOT_PPD;
    PRINT "Programming File Type: PPD";
    NOT_PPD:
    IF ( ! (TMPINT==STAPL) ) THEN GOTO NOT_STAPL;
    PRINT "Programming File Type: STAPL";
    NOT_STAPL:
    IF ( ! (TMPINT==SVF) ) THEN GOTO NOT_SVF;
    PRINT "Programming File Type: SVF";
    NOT_SVF:
    IF ( ! (TMPINT==PCF) ) THEN GOTO NOT_PCF;
    PRINT "Programming File Type: PCF";
    NOT_PCF:
    IF ( ! (TMPINT==IEEE1532) ) THEN GOTO NOT_IEEE1532;
    PRINT "Programming File Type: IEEE 1532";
    NOT_IEEE1532:
    IF ( ! ( (TMPINT==0)||(TMPINT==7)) ) THEN GOTO UNDEF_P_F_T;
    PRINT "Programming File Type:";
    UNDEF_P_F_T:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_UDV USES GV,DO_EXIT;
    BOOLEAN READ_UDV_RESULT[32];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $cd;
    DRSCAN 32, $00000000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 100000 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE READ_UDV_RESULT[];
        IF ( ! (READ_UDV_RESULT[31]==0) ) THEN GOTO UDV_POLL;
        IPOLL = 0;
        PASS = 1;
        UDV_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_UDV_DONE;
        IRSCAN 8, $cd;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_UDV_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO UDV_PASS;
    PRINT "Instruction timed out while reading udv.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    UDV_PASS:
    PRINT "Die Firmware Version: ",INT(READ_UDV_RESULT[30..24]),".",INT(READ_UDV_RESULT[23..16]);
    EXPORT "UDV", READ_UDV_RESULT[31..0];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE FIX_INT_ARRAYS USES GV;
    INTEGER TEMP =0;
    IF ( ! (HEX[0]!=48) ) THEN GOTO NOT_48;
    FOR I = 0 TO 7;
        TEMP = HEX[I];
        HEX[I] = HEX[(15-I)];
        HEX[(15-I)] = TEMP;
    NEXT I;
    NOT_48:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_DESIGN_INFO USES GV,DO_EXIT,READ_SHARED_BUFFER;
    BOOLEAN READ_DESIGN_INFO_RESULT[8];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $a6;
    DRSCAN 8, $00;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE READ_DESIGN_INFO_RESULT[];
        IF ( ! (READ_DESIGN_INFO_RESULT[7]==0) ) THEN GOTO READ_DESIGN_INFO_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_DESIGN_INFO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_DESIGN_INFO_DONE;
        IRSCAN 8, $a6;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_DESIGN_INFO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO READ_DESIGN_INFO_PASS;
    PRINT "Instruction timed out while reading design information.";
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    STATUS = -32;
    CALL DO_EXIT;
    READ_DESIGN_INFO_PASS:
    IBLOCKS = 3;
    CALL READ_SHARED_BUFFER;
    PRINT "Design Name: ",CHR$(INT(SHARED_BUFFER[23..16])),CHR$(INT(SHARED_BUFFER[31..24]))
        ,CHR$(INT(SHARED_BUFFER[39..32])),CHR$(INT(SHARED_BUFFER[47..40])),CHR$(INT(SHARED_BUFFER[55..48]))
        ,CHR$(INT(SHARED_BUFFER[63..56])),CHR$(INT(SHARED_BUFFER[71..64])),CHR$(INT(SHARED_BUFFER[79..72]))
        ,CHR$(INT(SHARED_BUFFER[87..80])),CHR$(INT(SHARED_BUFFER[95..88])),CHR$(INT(SHARED_BUFFER[103..96]))
        ,CHR$(INT(SHARED_BUFFER[111..104])),CHR$(INT(SHARED_BUFFER[119..112])),CHR$(INT(SHARED_BUFFER[127..120]))
        ,CHR$(INT(SHARED_BUFFER[135..128])),CHR$(INT(SHARED_BUFFER[143..136])),CHR$(INT(SHARED_BUFFER[151..144]))
        ,CHR$(INT(SHARED_BUFFER[159..152])),CHR$(INT(SHARED_BUFFER[167..160])),CHR$(INT(SHARED_BUFFER[175..168]))
        ,CHR$(INT(SHARED_BUFFER[183..176])),CHR$(INT(SHARED_BUFFER[191..184])),CHR$(INT(SHARED_BUFFER[199..192]))
        ,CHR$(INT(SHARED_BUFFER[207..200])),CHR$(INT(SHARED_BUFFER[215..208])),CHR$(INT(SHARED_BUFFER[223..216]))
        ,CHR$(INT(SHARED_BUFFER[231..224])),CHR$(INT(SHARED_BUFFER[239..232])),CHR$(INT(SHARED_BUFFER[247..240]))
        ,CHR$(INT(SHARED_BUFFER[255..248]));
    EXPORT "CHECKSUM", SHARED_BUFFER[15..0];
    EXPORT "READ_DESIGN_INFO: ", SHARED_BUFFER[271..0];
    EXPORT "DESIGNVER", SHARED_BUFFER[271..256];
    EXPORT "BACKLEVEL", SHARED_BUFFER[287..272];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_DIGEST USES GV,DO_EXIT,READ_SHARED_BUFFER;
    IF ( ! (SEC_UL[26]==1) ) THEN GOTO UL_EXTDIGEST_ENABLE_DIGEST;
    PRINT "Digest requests from SPI/JTAG is protected by user pass key 1";
    CALL DO_EXIT;
    UL_EXTDIGEST_ENABLE_DIGEST:
    BOOLEAN READ_DIGESTS_RESULT[8];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $a3;
    DRSCAN 8, $00;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 1000000 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE READ_DIGESTS_RESULT[7..0];
        IF ( ! (READ_DIGESTS_RESULT[7]==0) ) THEN GOTO READ_DIGESTS_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_DIGESTS_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_DIGESTS_DONE;
        IRSCAN 8, $a3;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_DIGESTS_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IBLOCKS = 6;
    CALL READ_SHARED_BUFFER;
    PRINT "Reading digests for all the segments from the device...";
    EXPORT "Fabric digest: ", SHARED_BUFFER[255..0];
    EXPORT "eNVM_0 digest: ", SHARED_BUFFER[511..256];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_PROGRAM USES GV,PROCESS_DATA,SET_MODE,DO_READ_DESIGN_INFO,DO_READ_DIGEST;
    PRINT "Programming FPGA Array and eNVM...";
    PGMMODE[7..0] = $01;
    CALL SET_MODE;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = DATASIZE;
    DATAINDEX = DATASTARTINDEX;
    PRINT "Calculating component bitstream digests using programming file...";
    CALL PROCESS_DATA;
    EXPORT "Entire bitstream digest", ENTIREBITSTREAMDIGEST[255..0];
    CALL DO_READ_DIGEST;
    CALL DO_READ_DESIGN_INFO;
    RANPROGRAMMINGACTION = 1;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_PROG_INFO USES GV,DO_EXIT;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $e7;
    DRSCAN 128, $00000000000000000000000000000000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 128, $00000000000000000000000000000000, CAPTURE READ_PROG_INFO_RESULT[];
        IF ( ! (READ_PROG_INFO_RESULT[127]==0) ) THEN GOTO READ_PROG_INFO_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_PROG_INFO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_PROG_INFO_DONE;
        IRSCAN 8, $e7;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_PROG_INFO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO READ_PROG_INFO_PASS;
    PRINT "Instruction timed out while reading programming information.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    READ_PROG_INFO_PASS:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_VERIFY_ZEROIZATION_DIGEST USES GV,CONSTBLOCK,SHA256,SHA256_INIT,SHA256_UPDATE
    ,SHA256_FINAL,DO_EXIT,READ_SHARED_BUFFER;
    BOOLEAN FETCH_ZERO_INPUT[129] = $fffffffffffffffffffffffffffffffff;
    BOOLEAN FETCH_ZERO_OUTPUT[129];
    BOOLEAN FETCH_ZERO_MATCH;
    BOOLEAN FETCH_ZERO_FSN[64];
    BOOLEAN FETCH_ZERO_DIGEST[256];
    BOOLEAN FETCH_ZERO_VALIDATOR[32];
    BOOLEAN FETCH_ZERO_FABRICRAMZEROIZED;
    INTEGER FETCH_ZERO_I;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $f5;
    DRSCAN 129, FETCH_ZERO_INPUT[128..0];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 1000000 TO 0 STEP -1;
        DRSCAN 129, $fffffffffffffffffffffffffffffffff, CAPTURE FETCH_ZERO_OUTPUT[128..0];
        IF ( ! (FETCH_ZERO_OUTPUT[128]==0) ) THEN GOTO FETCH_ZERO_POLL;
        IPOLL = 0;
        PASS = 1;
        FETCH_ZERO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO FETCH_ZERO_DONE;
        IRSCAN 8, $f5;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        FETCH_ZERO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO FETCH_ZERO_PASS1;
    PRINT "Instruction timed out while fetching zeroization result.";
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    STATUS = -32;
    CALL DO_EXIT;
    FETCH_ZERO_PASS1:
    IF ( ! (FETCH_ZERO_OUTPUT[0]==0) ) THEN GOTO FETCH_ZERO_DETECTED;
    PRINT "--- Previous zeroization results detected --- ";
    IBLOCKS = 5;
    CALL READ_SHARED_BUFFER;
    FETCH_ZERO_FSN[] = SHARED_BUFFER[63..0];
    FETCH_ZERO_DIGEST[] = SHARED_BUFFER[319..64];
    FETCH_ZERO_VALIDATOR[] = SHARED_BUFFER[72..41];
    FETCH_ZERO_FABRICRAMZEROIZED = FETCH_ZERO_OUTPUT[1];
    CALL SHA256_INIT;
    SHA256_UPDATE_DATA[447..192] = ZERO_10[255..0];
    SHA256_UPDATE_DATA[191..128] = FETCH_ZERO_FSN[63..0];
    SHA256_UPDATE_DATA[127..0] = $fffffffffffffffffffffffffffffffff;
    SHA256_UPDATE_DATA_SIZE = 448;
    CALL SHA256_UPDATE;
    CALL SHA256_FINAL;
    FETCH_ZERO_MATCH = 1;
    FOR FETCH_ZERO_I = 0 TO 255 STEP 1;
        IF ( ! (SHA256_HASH[FETCH_ZERO_I]!=FETCH_ZERO_DIGEST[FETCH_ZERO_I]) ) THEN GOTO FETCH_ZERO_CMPDG1;
        FETCH_ZERO_MATCH = 0;
        FETCH_ZERO_I = 255;
        FETCH_ZERO_CMPDG1:
        LABEL_SEPARATOR = 0;
    NEXT FETCH_ZERO_I;
    IF ( ! (FETCH_ZERO_MATCH==1) ) THEN GOTO FETCH_ZERO_MOD10;
    PRINT "Detected zeroization mode = 10 'like new'";
    FETCH_ZERO_MOD10:
    IF ( ! (FETCH_ZERO_MATCH==0) ) THEN GOTO FETCH_ZERO_MD0001;
    CALL SHA256_INIT;
    SHA256_UPDATE_DATA[447..192] = ZERO_00_01[255..0];
    SHA256_UPDATE_DATA[191..128] = FETCH_ZERO_FSN[63..0];
    SHA256_UPDATE_DATA[127..0] = $fffffffffffffffffffffffffffffffff;
    SHA256_UPDATE_DATA_SIZE = 448;
    CALL SHA256_UPDATE;
    CALL SHA256_FINAL;
    FETCH_ZERO_MATCH = 1;
    FOR FETCH_ZERO_I = 0 TO 255 STEP 1;
        IF ( ! (SHA256_HASH[FETCH_ZERO_I]!=FETCH_ZERO_DIGEST[FETCH_ZERO_I]) ) THEN GOTO FETCH_ZERO_CMPDG2;
        FETCH_ZERO_MATCH = 0;
        FETCH_ZERO_I = 255;
        FETCH_ZERO_CMPDG2:
        LABEL_SEPARATOR = 0;
    NEXT FETCH_ZERO_I;
    IF ( ! (FETCH_ZERO_MATCH==1) ) THEN GOTO FETCH_ZERO_0001MATCH;
    PRINT "Detected zeroization mode = 01 'recoverable' or 00 'non-recoverable'";
    FETCH_ZERO_0001MATCH:
    LABEL_SEPARATOR = 0;
    FETCH_ZERO_MD0001:
    IF ( ! (FETCH_ZERO_MATCH==1) ) THEN GOTO FETCH_ZERO_VEROK;
    PRINT "Zeroization digest has been verified";
    FETCH_ZERO_VEROK:
    IF ( ! (FETCH_ZERO_MATCH==0) ) THEN GOTO FETCH_ZERO_VERERR;
    PRINT "***Zeroization digest failed verification";
    FETCH_ZERO_VERERR:
    EXPORT "Zeroization data", SHARED_BUFFER[319..0];
    PRINT "---------------------------------------------";
    FETCH_ZERO_DETECTED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_VERIFY_DIGEST USES GV,DO_EXIT,READ_SHARED_BUFFER,DO_READ_DESIGN_INFO;
    CALL DO_READ_DESIGN_INFO;
    BOOLEAN CHECK_DIGESTS_RESULT[16];
    BOOLEAN CHECK_DIGESTS_INPUT[16];
    PASS = 0;
    INTEGER DIGEST_ERROR =0;
    CHECK_DIGESTS_INPUT[0] = 1;
    CHECK_DIGESTS_INPUT[1] = 1;
    CHECK_DIGESTS_INPUT[13..10] = BOOL(15);
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $bc;
    DRSCAN 16, CHECK_DIGESTS_INPUT[15..0];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 1000000 TO 0 STEP -1;
        DRSCAN 16, $0000, CAPTURE CHECK_DIGESTS_RESULT[15..0];
        IF ( ! (CHECK_DIGESTS_RESULT[15]==0) ) THEN GOTO CHECK_DIGESTS_POLL;
        IPOLL = 0;
        PASS = 1;
        CHECK_DIGESTS_POLL:
        IF ( ! (PASS==0) ) THEN GOTO CHECK_DIGESTS_DONE;
        IRSCAN 8, $bc;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        CHECK_DIGESTS_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO CHECK_DIGESTS_PASS1;
    PRINT "Instruction timed out while verifying digest.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    CHECK_DIGESTS_PASS1:
    IF ( ! (INT(CHECK_DIGESTS_INPUT[13..10])==INT(CHECK_DIGESTS_RESULT[13..10])) ) THEN GOTO UL_EXTDIGEST_NOT_ENABLED;
    PRINT "Digest request from SPI/JTAG is protected by user pass key 1.";
    STATUS = -18;
    UNIQUEEXITCODE = 32787;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    UL_EXTDIGEST_NOT_ENABLED:
    IF ( ! ( (PASS==1)&&(CHECK_DIGESTS_RESULT[14]==1)) ) THEN GOTO CHECK_DIGESTS_PASS3;
    PRINT "Failed while running verify digest.";
    STATUS = -19;
    UNIQUEEXITCODE = 32788;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    CHECK_DIGESTS_PASS3:
    IBLOCKS = 6;
    CALL READ_SHARED_BUFFER;
    IF ( ! (CHECK_DIGESTS_RESULT[0]==1) ) THEN GOTO FABRIC_DIGEST_FAIL;
    PRINT "FPGA Fabric digest verification: PASS";
    FABRIC_DIGEST_FAIL:
    IF ( ! (CHECK_DIGESTS_RESULT[0]==0) ) THEN GOTO FABRIC_DIGEST_PASS;
    PRINT "FPGA Fabric digest verification: FAIL";
    UNIQUEEXITCODE = 32789;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    FABRIC_DIGEST_PASS:
    EXPORT "FPGA FABRIC digest", SHARED_BUFFER[255..0];
    IF ( ! (CHECK_DIGESTS_RESULT[1]==1) ) THEN GOTO ENVM0_DIGEST_FAIL;
    PRINT "eNVM_0 digest verification: PASS";
    ENVM0_DIGEST_FAIL:
    IF ( ! (CHECK_DIGESTS_RESULT[1]==0) ) THEN GOTO ENVM0_DIGEST_PASS;
    PRINT "eNVM_0 digest verification: FAIL";
    UNIQUEEXITCODE = 32790;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    ENVM0_DIGEST_PASS:
    EXPORT "eNVM_0 digest", SHARED_BUFFER[511..256];
    IF ( ! (CHECK_DIGESTS_RESULT[6]==0) ) THEN GOTO FACTORY_PASS;
    PRINT "Factory row and factory key digest verification: FAIL";
    UNIQUEEXITCODE = 32795;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    FACTORY_PASS:
    IF ( ! (CHECK_DIGESTS_RESULT[6]==1) ) THEN GOTO FACTORY_FAIL;
    PRINT "Factory row and factory key digest verification: PASS";
    FACTORY_FAIL:
    PRINT "Factory row and factory key digest = Not Available";
    IF ( ! (CHECK_DIGESTS_RESULT[7]==1) ) THEN GOTO FABRIC_CONFIG_FAIL;
    PRINT "Fabric configuration digest verification: PASS";
    FABRIC_CONFIG_FAIL:
    IF ( ! (CHECK_DIGESTS_RESULT[7]==0) ) THEN GOTO FABRIC_CONFIG_PASS;
    PRINT "Fabric configuration digest verification: FAIL";
    UNIQUEEXITCODE = 32796;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    FABRIC_CONFIG_PASS:
    PRINT "Fabric configuration digest = Not Available";
    IF ( ! (DIGEST_ERROR==1) ) THEN GOTO ALL_DIGEST_PASSED;
    STATUS = -20;
    ALL_DIGEST_PASSED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_DEVICE_INFO USES GV,READ_FSN,DO_EXIT,DUMP_SECURITY_INFO,DO_READ_SECURITY
    ,PRINT_IDCODE,DUMP_PROG_INFO,DO_READ_UDV,DO_READ_DESIGN_INFO,DO_READ_DIGEST,DO_READ_PROG_INFO
    ,DO_VERIFY_ZEROIZATION_DIGEST;
    CALL PRINT_IDCODE;
    PRINT "Die Revision: ",IDREV;
    CALL DO_READ_UDV;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $0e;
    WAIT IDLE, 1 CYCLES;
    DRSCAN 32, $00000000, CAPTURE BUFF32[];
    IF ( ! (INT(BUFF32[31..0])==-1) ) THEN GOTO NOT_EMPTY_SILSIG;
    BUFF32[31..0] = $00000000;
    NOT_EMPTY_SILSIG:
    EXPORT "SILSIG", BUFF32[];
    CALL DO_READ_DESIGN_INFO;
    IRSCAN 8, $8f, CAPTURE BUFF32[7..0];
    IF ( ! (BUFF32[2]==1) ) THEN GOTO CORE_NOT_ENABLED;
    PRINT "FPGA Array is programmed and enabled.";
    CORE_NOT_ENABLED:
    IF ( ! (BUFF32[2]==0) ) THEN GOTO CORE_ENABLED;
    PRINT "FPGA Array is not enabled.";
    CORE_ENABLED:
    CALL DO_VERIFY_ZEROIZATION_DIGEST;
    CALL DO_READ_PROG_INFO;
    CALL DUMP_PROG_INFO;
    CALL READ_FSN;
    IF ( ! (READ_FSN_RESULT[128]==1) ) THEN GOTO FSN_NOT_BUSY;
    CALL DO_EXIT;
    FSN_NOT_BUSY:
    CALL DO_READ_DIGEST;
    CALL DO_READ_SECURITY;
    CALL DUMP_SECURITY_INFO;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE VALID_CORTEXM3_090_150_REVA USES GV,DO_EXIT;
    IF ( ! ( (INT(ID[27..0])==INT(M2S150[31..0]))||(INT(ID[27..0])==INT(M2S090[31..0]))) ) THEN GOTO NOT_090_150;
    IF ( ! (IDREV==0) ) THEN GOTO NOT_REV_A;
    IF ( ! (BENVMFIRSTPAGEZEROS==1) ) THEN GOTO NOT_FIRST_PAGE_ZEROS;
    PRINT "Please have valid Cortex-M3 firmware code client at page 0 for Rev 0 M2S090 and M2S150 devices
        , else it will lead to unexpected behavior including programming lockout condition. Please see section 3.14 at https://www.microsemi.com/document-portal/doc_download/135070-er0196-smartfusion2-device-errata .";
    STATUS = -35;
    UNIQUEEXITCODE = 32853;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    NOT_FIRST_PAGE_ZEROS:
    LABEL_SEPARATOR = 0;
    NOT_REV_A:
    LABEL_SEPARATOR = 0;
    NOT_090_150:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_CHECK_CYCLE_COUNT USES GV,DO_READ_PROG_INFO;
    INTEGER CYCLECOUNT =0;
    INTEGER MAXCYCLECOUNT =500;
    CALL DO_READ_PROG_INFO;
    CYCLECOUNT = INT(READ_PROG_INFO_RESULT[15..0]);
    IF ( ! (CYCLECOUNT!=65535) ) THEN GOTO UNKNOWN_CYCLE_COUNT2;
    IF ( ! ( (CYCLECOUNT>=(MAXCYCLECOUNT-50))&&(CYCLECOUNT<MAXCYCLECOUNT)) ) THEN GOTO NOT_LAST_CYCLE_COUNT;
    PRINT "Info: You are ",(MAXCYCLECOUNT-CYCLECOUNT)," cycles away from maximum programming cycle count of "
        ,MAXCYCLECOUNT," on this device. Refer to your device datasheet for more details.";
    NOT_LAST_CYCLE_COUNT:
    IF ( ! (CYCLECOUNT==MAXCYCLECOUNT) ) THEN GOTO WARN_CYCLE_COUNT;
    PRINT "Info: You are in the last cycle to reach maximum programming cycle count of "
        ,MAXCYCLECOUNT," on this device. Refer to your device datasheet for more details.";
    WARN_CYCLE_COUNT:
    IF ( ! (CYCLECOUNT>MAXCYCLECOUNT) ) THEN GOTO NO_WARN_CYCLE_COUNT;
    PRINT "Warning: You have exceeded the maximum programming cycle count of ",MAXCYCLECOUNT
        ," on this device. Refer to your device datasheet for more details.";
    NO_WARN_CYCLE_COUNT:
    LABEL_SEPARATOR = 0;
    UNKNOWN_CYCLE_COUNT2:
    LABEL_SEPARATOR = 0;
ENDPROC;


CRC A2F6;
